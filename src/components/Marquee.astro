---
const items = [
  "Arztpraxen",
  "Steuerkanzleien",
  "Tischlereien",
  "Restaurants",
  "Architekten",
  "Physiotherapie",
  "Hotels",
  "Bäckereien",
  "Friseure",
  "Anwaltskanzleien",
];
---

<section
  class="marquee-section py-12 md:py-16 border-y border-[var(--color-line)] overflow-hidden bg-[var(--color-surface)]"
>
  <div class="marquee-track flex items-center gap-12 md:gap-20 whitespace-nowrap">
    {
      [...items, ...items, ...items].map((b) => (
        <span class="font-display text-2xl md:text-3xl tracking-tight text-[var(--color-ink-soft)] inline-flex items-center gap-12 md:gap-20">
          {b}
          <span class="h-1.5 w-1.5 rounded-full bg-[var(--color-accent)]" />
        </span>
      ))
    }
  </div>
</section>

<style>
  @keyframes scroll {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-33.333%);
    }
  }

  .marquee-track {
    animation: scroll 40s linear infinite;
  }

  .marquee-section:hover .marquee-track {
    animation-play-state: paused;
  }
</style>
