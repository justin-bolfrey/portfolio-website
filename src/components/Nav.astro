---
const links = [
  { href: "/#leistungen", label: "Leistungen" },
  { href: "/#arbeiten", label: "Arbeiten" },
  { href: "/#prozess", label: "Prozess" },
  { href: "/#kontakt", label: "Kontakt" },
];
---

<header
  class="sticky top-0 z-40 backdrop-blur-md bg-[var(--color-bg)]/75 border-b border-[var(--color-line)]"
>
  <div class="container-page flex h-16 items-center justify-between">
    <a href="/" class="flex items-center gap-2 group" aria-label="Startseite">
      <span
        class="grid place-items-center h-8 w-8 rounded-lg bg-[var(--color-ink)] text-[var(--color-bg)] font-display font-semibold"
        >jb</span
      >
      <span class="font-display text-base font-medium tracking-tight">Bolfrey<span class="text-[var(--color-accent)]">.</span>Studio</span>
    </a>

    <nav class="hidden md:flex items-center gap-8 text-sm text-[var(--color-ink-soft)]">
      {
        links.map((l) => (
          <a
            href={l.href}
            class="hover:text-[var(--color-ink)] transition-colors duration-200"
          >
            {l.label}
          </a>
        ))
      }
    </nav>

    <a href="/#kontakt" class="btn btn-primary text-sm">
      Projekt starten
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M5 12h14"/><path d="m12 5 7 7-7 7"/>
      </svg>
    </a>
  </div>
</header>
