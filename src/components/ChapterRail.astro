---
const chapters = [
  { id: "anliegen", n: "01", label: "Anliegen" },
  { id: "versprechen", n: "02", label: "Versprechen" },
  { id: "leistungen", n: "03", label: "Leistungen" },
  { id: "prozess", n: "04", label: "Prozess" },
  { id: "arbeiten", n: "05", label: "Beweise" },
  { id: "kontakt", n: "06", label: "Kontakt" },
];
---

<aside
  id="chapter-rail"
  class="hidden lg:flex fixed left-6 xl:left-10 top-1/2 -translate-y-1/2 z-30 flex-col gap-5 opacity-0 transition-opacity duration-500 mix-blend-difference text-[var(--color-bg)]"
  aria-label="Kapitel-Navigation"
>
  {
    chapters.map((c) => (
      <a
        href={`#${c.id}`}
        data-chapter-target={c.id}
        class="group flex items-center gap-3 text-xs font-medium tracking-widest uppercase"
      >
        <span class="relative grid place-items-center w-6 h-6">
          <span class="absolute inset-0 rounded-full border border-current opacity-30 group-hover:opacity-100 transition-opacity" />
          <span
            class="chapter-dot h-1.5 w-1.5 rounded-full bg-current opacity-30 group-hover:opacity-100 transition-all duration-300"
          />
        </span>
        <span class="chapter-label flex items-center gap-2 transition-all duration-300 opacity-0 -translate-x-1 pointer-events-none">
          <span class="font-display tabular-nums">{c.n}</span>
          <span>{c.label}</span>
        </span>
      </a>
    ))
  }
</aside>

<script>
  const rail = document.getElementById("chapter-rail");
  if (rail) {
    const links = Array.from(rail.querySelectorAll<HTMLAnchorElement>("[data-chapter-target]"));
    const ids = links
      .map((l) => l.dataset.chapterTarget)
      .filter((x): x is string => Boolean(x));

    const setActive = (id: string | null) => {
      links.forEach((link) => {
        const isActive = link.dataset.chapterTarget === id;
        link.classList.toggle("is-active", isActive);
        const dot = link.querySelector(".chapter-dot");
        const label = link.querySelector(".chapter-label");
        if (dot) {
          dot.classList.toggle("opacity-100", isActive);
          dot.classList.toggle("scale-150", isActive);
          dot.classList.toggle("opacity-30", !isActive);
        }
        if (label) {
          label.classList.toggle("opacity-100", isActive);
          label.classList.toggle("translate-x-0", isActive);
          label.classList.toggle("opacity-0", !isActive);
          label.classList.toggle("-translate-x-1", !isActive);
        }
      });
    };

    const observer = new IntersectionObserver(
      (entries) => {
        const visible = entries
          .filter((e) => e.isIntersecting)
          .sort((a, b) => b.intersectionRatio - a.intersectionRatio);
        if (visible.length > 0) {
          setActive(visible[0].target.id);
        }
      },
      { rootMargin: "-30% 0px -55% 0px", threshold: [0, 0.25, 0.5, 0.75, 1] },
    );

    ids.forEach((id) => {
      const el = document.getElementById(id);
      if (el) observer.observe(el);
    });

    let revealed = false;
    const reveal = () => {
      if (revealed) return;
      if (window.scrollY > 200) {
        rail.style.opacity = "1";
        revealed = true;
      }
    };
    const onScroll = () => {
      if (window.scrollY > 200 && !revealed) reveal();
      else if (window.scrollY <= 200 && revealed) {
        rail.style.opacity = "0";
        revealed = false;
      }
    };
    window.addEventListener("scroll", onScroll, { passive: true });
    onScroll();
  }
</script>
