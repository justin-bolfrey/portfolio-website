---
/**
 * Inline setup-Balkenlogo mit Hover-Animation der drei Balken.
 * idPrefix muss pro Instanz auf der Seite eindeutig sein (z. B. logo-hdr / logo-ftr).
 */
interface Props {
  class?: string;
  idPrefix: string;
  /** z. B. `header-logo-mark` für die Scroll-Fluganimation (Hero → Header) */
  slotId?: string;
}

const { class: className = "h-16 w-16", idPrefix, slotId } = Astro.props;
const gid = (suffix: string) => `${idPrefix}-${suffix}`;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  id={slotId}
  viewBox="0 0 800 552"
  fill="none"
  class:list={["logo-mark shrink-0 overflow-visible", className]}
  aria-hidden="true"
  focusable="false"
>
  <defs>
    <linearGradient id={gid("top")} x1="0" y1="88" x2="800" y2="88" gradientUnits="userSpaceOnUse">
      <stop stop-color="#0B1020" />
      <stop offset="1" stop-color="#3F5074" />
    </linearGradient>
    <linearGradient id={gid("middle")} x1="100" y1="320" x2="700" y2="320" gradientUnits="userSpaceOnUse">
      <stop stop-color="#1E3A5F" />
      <stop offset="1" stop-color="#5F5F8B" />
    </linearGradient>
    <linearGradient id={gid("bottom")} x1="200" y1="508" x2="600" y2="508" gradientUnits="userSpaceOnUse">
      <stop stop-color="#949FAD" />
      <stop offset="1" stop-color="#B0A9BB" />
    </linearGradient>
  </defs>
  <rect class="logo-bar logo-bar-a" data-logo-bar="a" x="1" y="0" width="798" height="176" rx="64" fill={`url(#${gid("top")})`} />
  <rect class="logo-bar logo-bar-b" data-logo-bar="b" x="100" y="254" width="600" height="132" rx="64" fill={`url(#${gid("middle")})`} />
  <rect class="logo-bar logo-bar-c" data-logo-bar="c" x="200" y="464" width="400" height="88" rx="44" fill={`url(#${gid("bottom")})`} />
</svg>

<style>
  .logo-bar {
    transform-box: fill-box;
    transform-origin: center;
    transition: transform 0.42s cubic-bezier(0.34, 1.35, 0.64, 1);
  }

  .logo-bar-a {
    transition-delay: 0ms;
  }
  .logo-bar-b {
    transition-delay: 45ms;
  }
  .logo-bar-c {
    transition-delay: 90ms;
  }

  :global(.logo-hover-target:hover) .logo-bar-a {
    transform: rotate(-8deg) translateY(-5%);
  }
  :global(.logo-hover-target:hover) .logo-bar-b {
    transform: rotate(6deg) translateY(1.5%);
  }
  :global(.logo-hover-target:hover) .logo-bar-c {
    transform: rotate(-7deg) translateY(7%);
  }

  @media (prefers-reduced-motion: reduce) {
    .logo-bar {
      transition: none;
    }
    :global(.logo-hover-target:hover) .logo-bar-a,
    :global(.logo-hover-target:hover) .logo-bar-b,
    :global(.logo-hover-target:hover) .logo-bar-c {
      transform: none;
    }
  }
</style>
