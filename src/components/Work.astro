---
const projects = [
  {
    title: "Praxis Dr. Lindner",
    branch: "Zahnarztpraxis · Würzburg",
    summary:
      "Vom verstaubten Wix-Auftritt zur klaren Praxis-Website mit Online-Terminbuchung.",
    metric: "+62%",
    metricLabel: "Online-Terminanfragen",
    accent: "from-[#e6eaf4] to-[#f2f5fb]",
    tag: "2025",
  },
  {
    title: "Steuerkanzlei Renner",
    branch: "Kanzlei · Schweinfurt",
    summary:
      "Klare Mandanten-Kommunikation, sicherer Dokumenten-Upload, lokales SEO für die Region Mainfranken.",
    metric: "<1.2s",
    metricLabel: "Ladezeit (LCP)",
    accent: "from-[#e2e7f3] to-[#eef2fa]",
    tag: "2024",
  },
  {
    title: "Tischlerei Hartmann",
    branch: "Handwerk · Bad Kissingen",
    summary:
      "Bilderstarke Galerie für Möbelstücke, einfaches Anfrage-Formular, auf dem Handy genauso gut wie am Desktop.",
    metric: "100",
    metricLabel: "Lighthouse Performance",
    accent: "from-[#dee4f1] to-[#eaeff8]",
    tag: "2024",
  },
  {
    title: "Restaurant Olivenhain",
    branch: "Gastronomie · Aschaffenburg",
    summary:
      "Karte als PDF von gestern. Heute: dynamische Speisekarte, Reservierung per SMS, Instagram-Feed.",
    metric: "3.2×",
    metricLabel: "Reservierungen / Monat",
    accent: "from-[#dae0ef] to-[#e7ecf7]",
    tag: "2025",
  },
];
---

<section id="arbeiten" class="py-28 md:py-40 scroll-mt-28 bg-[var(--color-surface)] border-y border-[var(--color-line)]">
  <div class="container-page">
    <div class="flex items-end justify-between flex-wrap gap-6">
      <div class="max-w-2xl">
        <span class="eyebrow reveal">Kap. 05 · Beweise</span>
        <h2
          class="reveal reveal-delay-1 mt-6 font-display text-4xl md:text-5xl leading-[1.05] tracking-tight"
        >
          Echte Kunden.<br />Echte Ergebnisse.
        </h2>
      </div>
      <p class="reveal reveal-delay-2 text-[var(--color-ink-soft)] max-w-md">
        Vier kleine Geschichten von Unternehmen aus Mainfranken und Unterfranken,
        die ihre Website neu gedacht haben.
      </p>
    </div>

    <div class="mt-16 grid md:grid-cols-2 gap-6 md:gap-8">
      {
        projects.map((p, i) => (
          <a
            href="#kontakt"
            class={`focus-zoom reveal reveal-delay-${(i % 4) + 1} group block rounded-2xl border border-[var(--color-line)] overflow-hidden bg-[var(--color-bg)] hover:border-[var(--color-ink)] transition-all duration-300`}
          >
            <div class={`relative aspect-[16/10] bg-gradient-to-br ${p.accent} overflow-hidden`}>
              <div class="absolute inset-0 grid place-items-center">
                <div class="font-display italic text-3xl md:text-4xl text-[var(--color-ink)]/35 tracking-tight">
                  {p.title}
                </div>
              </div>
              <div class="absolute top-4 left-4 text-xs uppercase tracking-widest text-[var(--color-ink)]/55">
                {p.tag}
              </div>
              <div class="absolute bottom-4 right-4 flex items-center gap-3 bg-[var(--color-bg)]/85 backdrop-blur rounded-full px-4 py-2 text-xs">
                <span class="font-display text-base">{p.metric}</span>
                <span class="text-[var(--color-ink-soft)]">{p.metricLabel}</span>
              </div>
            </div>

            <div class="p-7 md:p-8">
              <div class="flex items-start justify-between gap-3">
                <div>
                  <h3 class="font-display text-2xl tracking-tight">{p.title}</h3>
                  <p class="text-sm text-[var(--color-ink-soft)] mt-1">{p.branch}</p>
                </div>
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" class="text-[var(--color-ink-soft)] group-hover:text-[var(--color-accent)] group-hover:translate-x-1 group-hover:-translate-y-1 transition-all duration-300">
                  <path d="M7 17 17 7"/><path d="M8 7h9v9"/>
                </svg>
              </div>
              <p class="mt-5 text-[var(--color-ink-soft)] leading-relaxed">
                {p.summary}
              </p>
            </div>
          </a>
        ))
      }
    </div>
  </div>
</section>
