---
import "~/styles/global.css";
import Nav from "~/components/Nav.astro";
import Footer from "~/components/Footer.astro";
import ScrollProgress from "~/components/ScrollProgress.astro";
import ChapterRail from "~/components/ChapterRail.astro";

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const {
  title = "setup — Webdesign für regionale Unternehmen",
  description = "Klare, schnelle Websites für Arztpraxen, Kanzleien, Handwerk & Gastronomie. Maßgeschneidertes Design, technisch sauber, DSGVO-konform.",
  image = "/og.png",
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site ?? "https://example.com").toString();
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />

    <title>{title}</title>
    <meta name="description" content={description} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={image} />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Poppins:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500;1,600;1,700&display=swap"
    />

    <meta name="theme-color" content="#f4f6fb" />
  </head>
  <body class="min-h-screen flex flex-col">
    <ScrollProgress />
    <ChapterRail />
    <Nav />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />

    <script>
      // 1. Reveal-on-scroll
      const revealObserver = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add("is-visible");
              revealObserver.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.12, rootMargin: "0px 0px -8% 0px" },
      );

      // 2. Count-up on view (data-count-to="75" data-count-suffix="%")
      const easeOut = (t: number) => 1 - Math.pow(1 - t, 3);
      const countObserver = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            const el = entry.target as HTMLElement;
            const to = parseFloat(el.dataset.countTo || "0");
            const suffix = el.dataset.countSuffix || "";
            const prefix = el.dataset.countPrefix || "";
            const decimals = parseInt(el.dataset.countDecimals || "0", 10);
            const duration = 1400;
            const start = performance.now();
            const tick = (t: number) => {
              const p = Math.min(1, (t - start) / duration);
              const value = to * easeOut(p);
              el.textContent = `${prefix}${value.toFixed(decimals)}${suffix}`;
              if (p < 1) requestAnimationFrame(tick);
              else el.textContent = `${prefix}${to.toFixed(decimals)}${suffix}`;
            };
            requestAnimationFrame(tick);
            countObserver.unobserve(el);
          });
        },
        { threshold: 0.4 },
      );

      /** Sanfteres Ankern als natives scroll-behavior (weicheres Easing, Dauer abhängig von Distanz). */
      function easeInOutQuint(t: number) {
        return t < 0.5 ? 16 * t * t * t * t * t : 1 - Math.pow(-2 * t + 2, 5) / 2;
      }

      function scrollTopForElement(el: Element) {
        const rect = el.getBoundingClientRect();
        const margin = parseFloat(getComputedStyle(el).scrollMarginTop) || 0;
        return window.scrollY + rect.top - margin;
      }

      let smoothScrollRaf = 0;
      function smoothScrollToY(targetY: number, duration: number) {
        cancelAnimationFrame(smoothScrollRaf);
        const startY = window.scrollY;
        const distance = targetY - startY;
        const t0 = performance.now();

        function frame(now: number) {
          const elapsed = now - t0;
          const p = Math.min(1, elapsed / duration);
          window.scrollTo(0, startY + distance * easeInOutQuint(p));
          if (p < 1) smoothScrollRaf = requestAnimationFrame(frame);
        }
        smoothScrollRaf = requestAnimationFrame(frame);
      }

      function initSmoothAnchors() {
        const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
        if (reduce) return;

        document.addEventListener(
          "click",
          (e) => {
            const a = (e.target as Element | null)?.closest?.("a");
            if (!(a instanceof HTMLAnchorElement) || !a.href) return;

            let url: URL;
            try {
              url = new URL(a.href);
            } catch {
              return;
            }
            if (url.origin !== window.location.origin) return;
            if (!url.hash || url.hash === "#") return;

            const path = url.pathname.replace(/\/$/, "") || "/";
            const here = window.location.pathname.replace(/\/$/, "") || "/";
            if (path !== here) return;

            const id = decodeURIComponent(url.hash.slice(1));
            const el = document.getElementById(id);
            if (!el) return;

            e.preventDefault();
            const targetY = scrollTopForElement(el);
            const dist = Math.abs(targetY - window.scrollY);
            const duration = Math.min(1650, Math.max(620, dist * 0.72));

            history.pushState(null, "", `${url.pathname}${url.search}${url.hash}`);
            smoothScrollToY(targetY, duration);
          },
          true,
        );
      }

      const init = () => {
        document.querySelectorAll(".reveal").forEach((el) => revealObserver.observe(el));
        document
          .querySelectorAll<HTMLElement>("[data-count-to]")
          .forEach((el) => countObserver.observe(el));
        initSmoothAnchors();
      };

      if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", init);
      } else {
        init();
      }
    </script>
  </body>
</html>
